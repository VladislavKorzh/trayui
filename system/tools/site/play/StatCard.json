{
  "lead": "One figure that matters: which one (each says whether its direction is welcome), the card’s fill, the line of its last weeks, and what the change is compared with.",
  "controls": [
    {"name": "figure", "label": "Figure", "options": [["revenue", "Revenue"], ["refunds", "Refunds"], ["packing", "Packing"], ["returning", "Returning"]]},
    {"name": "look", "label": "Fill", "options": [["", "Ground"], [" tray-island", "Yellow"], [" tray-inverse", "Ink"]]},
    {"name": "spark", "label": "Spark line", "type": "switch", "default": true},
    {"name": "link", "label": "Whole card a link", "type": "switch"},
    {"name": "vs", "label": "Compared with", "type": "text", "default": "than in October", "max": 40}
  ],
  "template": "<div class=\"tray-stats\">{{#figure=revenue}}{{^link}}<div class=\"tray-stat{{look}}\"><p class=\"tray-stat__label\">Revenue this month</p><p class=\"tray-stat__value\">$18,240</p><p class=\"tray-stat__foot\"><span class=\"tray-trend\" data-tone=\"good\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-trending-up\"/></svg>+14%</span>{{vs}}</p>{{#spark}}<div data-tray=\"spark\" data-points=\"9,11,10,13,12,15,14,18\"></div>{{/spark}}</div>{{/link}}{{#link}}<a class=\"tray-stat{{look}}\" href=\"/reports/revenue\"><p class=\"tray-stat__label\">Revenue this month<svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-arrow-up-right\"/></svg></p><p class=\"tray-stat__value\">$18,240</p><p class=\"tray-stat__foot\"><span class=\"tray-trend\" data-tone=\"good\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-trending-up\"/></svg>+14%</span>{{vs}}</p>{{#spark}}<div data-tray=\"spark\" data-points=\"9,11,10,13,12,15,14,18\"></div>{{/spark}}</a>{{/link}}{{/figure=revenue}}{{#figure=refunds}}{{^link}}<div class=\"tray-stat{{look}}\"><p class=\"tray-stat__label\">Refunds</p><p class=\"tray-stat__value\">3</p><p class=\"tray-stat__foot\"><span class=\"tray-trend\" data-tone=\"good\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-trending-down\"/></svg>&minus;2</span>{{vs}}</p>{{#spark}}<div data-tray=\"spark\" data-points=\"6,5,7,5,4,5,3,3\"></div>{{/spark}}</div>{{/link}}{{#link}}<a class=\"tray-stat{{look}}\" href=\"/reports/refunds\"><p class=\"tray-stat__label\">Refunds<svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-arrow-up-right\"/></svg></p><p class=\"tray-stat__value\">3</p><p class=\"tray-stat__foot\"><span class=\"tray-trend\" data-tone=\"good\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-trending-down\"/></svg>&minus;2</span>{{vs}}</p>{{#spark}}<div data-tray=\"spark\" data-points=\"6,5,7,5,4,5,3,3\"></div>{{/spark}}</a>{{/link}}{{/figure=refunds}}{{#figure=packing}}{{^link}}<div class=\"tray-stat{{look}}\"><p class=\"tray-stat__label\">Time to pack</p><p class=\"tray-stat__value\">26<small>min</small></p><p class=\"tray-stat__foot\"><span class=\"tray-trend\" data-tone=\"bad\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-trending-up\"/></svg>+4 min</span>{{vs}}</p>{{#spark}}<div data-tray=\"spark\" data-points=\"20,21,20,22,23,22,25,26\"></div>{{/spark}}</div>{{/link}}{{#link}}<a class=\"tray-stat{{look}}\" href=\"/reports/packing\"><p class=\"tray-stat__label\">Time to pack<svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-arrow-up-right\"/></svg></p><p class=\"tray-stat__value\">26<small>min</small></p><p class=\"tray-stat__foot\"><span class=\"tray-trend\" data-tone=\"bad\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-trending-up\"/></svg>+4 min</span>{{vs}}</p>{{#spark}}<div data-tray=\"spark\" data-points=\"20,21,20,22,23,22,25,26\"></div>{{/spark}}</a>{{/link}}{{/figure=packing}}{{#figure=returning}}{{^link}}<div class=\"tray-stat{{look}}\"><p class=\"tray-stat__label\">Returning customers</p><p class=\"tray-stat__value\">61%</p><p class=\"tray-stat__foot\"><span class=\"tray-trend\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-trending-up\"/></svg>+3 points</span>{{vs}}</p>{{#spark}}<div data-tray=\"spark\" data-points=\"52,55,54,57,58,57,60,61\"></div>{{/spark}}</div>{{/link}}{{#link}}<a class=\"tray-stat{{look}}\" href=\"/reports/customers\"><p class=\"tray-stat__label\">Returning customers<svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-arrow-up-right\"/></svg></p><p class=\"tray-stat__value\">61%</p><p class=\"tray-stat__foot\"><span class=\"tray-trend\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-trending-up\"/></svg>+3 points</span>{{vs}}</p>{{#spark}}<div data-tray=\"spark\" data-points=\"52,55,54,57,58,57,60,61\"></div>{{/spark}}</a>{{/link}}{{/figure=returning}}</div>"
}
