{
  "lead": "A skeleton in the shape of what is coming: rows of a list, a paragraph or a card, with the label a screen reader hears.",
  "width": "34rem",
  "controls": [
    { "name": "shape", "label": "Shape", "options": [["list", "List"], ["text", "Text"], ["card", "Card"]] },
    { "name": "rows", "label": "Rows", "options": [["1", "1"], ["2", "2"], ["3", "3"]], "default": "2" },
    { "name": "label", "label": "Read out as", "type": "text", "default": "Loading orders", "max": 40 }
  ],
  "template": "<div aria-busy=\"true\"><span class=\"tray-vh\">{{label}}</span><div class=\"tray-stack\" aria-hidden=\"true\">{{#shape=list}}<div class=\"tray-row\" style=\"gap: var(--space-3)\"><span class=\"tray-skeleton tray-skeleton--avatar\"></span><div class=\"tray-stack tray-stack--sm\" style=\"flex: 1\"><span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 60%; block-size: 16px\"></span><span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 35%; block-size: 12px\"></span></div></div>{{^rows=1}}<div class=\"tray-row\" style=\"gap: var(--space-3)\"><span class=\"tray-skeleton tray-skeleton--avatar\"></span><div class=\"tray-stack tray-stack--sm\" style=\"flex: 1\"><span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 48%; block-size: 16px\"></span><span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 28%; block-size: 12px\"></span></div></div>{{/rows=1}}{{#rows=3}}<div class=\"tray-row\" style=\"gap: var(--space-3)\"><span class=\"tray-skeleton tray-skeleton--avatar\"></span><div class=\"tray-stack tray-stack--sm\" style=\"flex: 1\"><span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 66%; block-size: 16px\"></span><span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 40%; block-size: 12px\"></span></div></div>{{/rows=3}}{{/shape=list}}{{#shape=text}}<span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 45%; block-size: 24px\"></span><span class=\"tray-skeleton tray-skeleton--text\" style=\"block-size: 14px\"></span>{{^rows=1}}<span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 88%; block-size: 14px\"></span>{{/rows=1}}{{#rows=3}}<span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 52%; block-size: 14px\"></span>{{/rows=3}}{{/shape=text}}{{#shape=card}}<span class=\"tray-skeleton tray-skeleton--card\" style=\"block-size: 10rem\"></span><span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 55%; block-size: 18px\"></span>{{^rows=1}}<span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 30%; block-size: 14px\"></span>{{/rows=1}}{{#rows=3}}<span class=\"tray-skeleton tray-skeleton--text\" style=\"inline-size: 42%; block-size: 14px\"></span>{{/rows=3}}{{/shape=card}}</div></div>"
}
