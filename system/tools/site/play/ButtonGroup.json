{
  "lead": "Related buttons in one tray: actions on an order, icon actions split by a rule, a quantity stepper, or a main action with more choices.",
  "controls": [
    { "name": "kind", "label": "Example", "options": [["actions", "Actions"], ["icons", "Icons"], ["stepper", "Stepper"], ["split", "Split"]] },
    { "name": "size", "label": "Size", "options": [["", "52px"], [" tray-btn-group--sm", "44px"]] },
    { "name": "vertical", "label": "Vertical", "type": "switch" }
  ],
  "template": "{{#kind=actions}}<div class=\"tray-btn-group{{size}}{{#vertical}} tray-btn-group--vertical{{/vertical}}\" role=\"group\" aria-label=\"Order actions\"><button class=\"tray-btn-group__item\" type=\"button\">{{icon:package}}Mark packed</button><button class=\"tray-btn-group__item\" type=\"button\">Print label</button><button class=\"tray-btn-group__item\" type=\"button\">Archive</button></div>{{/kind=actions}}{{#kind=icons}}<div class=\"tray-btn-group{{size}}{{#vertical}} tray-btn-group--vertical{{/vertical}}\" role=\"group\" aria-label=\"Invoice actions\"><button class=\"tray-btn-group__item tray-btn-group__item--icon\" type=\"button\" aria-label=\"Copy the link\">{{icon:copy}}</button><button class=\"tray-btn-group__item tray-btn-group__item--icon\" type=\"button\" aria-label=\"Download\">{{icon:download}}</button><button class=\"tray-btn-group__item tray-btn-group__item--icon\" type=\"button\" aria-label=\"Share\">{{icon:share}}</button><span class=\"tray-btn-group__rule\"></span><button class=\"tray-btn-group__item tray-btn-group__item--icon\" type=\"button\" aria-label=\"Delete\">{{icon:trash-2}}</button></div>{{/kind=icons}}{{#kind=stepper}}<div class=\"tray-btn-group{{size}}{{#vertical}} tray-btn-group--vertical{{/vertical}}\" role=\"group\" aria-label=\"Jars\" data-tray=\"stepper\" data-min=\"1\" data-max=\"9\">{{^vertical}}<button class=\"tray-btn-group__item tray-btn-group__item--icon\" type=\"button\" data-step=\"-1\" aria-label=\"One fewer\">{{icon:minus}}</button>{{/vertical}}{{#vertical}}<button class=\"tray-btn-group__item tray-btn-group__item--icon\" type=\"button\" data-step=\"1\" aria-label=\"One more\">{{icon:plus}}</button>{{/vertical}}<output class=\"tray-btn-group__value\">2</output>{{^vertical}}<button class=\"tray-btn-group__item tray-btn-group__item--icon\" type=\"button\" data-step=\"1\" aria-label=\"One more\">{{icon:plus}}</button>{{/vertical}}{{#vertical}}<button class=\"tray-btn-group__item tray-btn-group__item--icon\" type=\"button\" data-step=\"-1\" aria-label=\"One fewer\">{{icon:minus}}</button>{{/vertical}}</div>{{/kind=stepper}}{{#kind=split}}<div class=\"tray-btn-group{{size}}{{#vertical}} tray-btn-group--vertical{{/vertical}}\" role=\"group\" aria-label=\"Save\"><button class=\"tray-btn-group__item\" type=\"button\">Save draft</button><button class=\"tray-btn-group__item tray-btn-group__item--icon\" type=\"button\" aria-label=\"More ways to save\">{{icon:chevron-down}}</button></div>{{/kind=split}}"
}
