{
  "lead": "A tray that takes files dropped on it or chosen, and lists them under it: uploading, too large, or stopped with a way to try again.",
  "width": "36rem",
  "controls": [
    { "name": "form", "label": "Form", "options": [["", "Tray"], ["row", "Row"]] },
    { "name": "files", "label": "Files", "options": [["none", "None"], ["uploading", "Uploading"], ["large", "Too large"], ["failed", "Failed"]], "default": "uploading" },
    { "name": "over", "label": "Held over", "type": "switch" },
    { "name": "label", "label": "Label", "type": "text", "default": "Product photos", "max": 40 },
    { "name": "detail", "label": "Kinds and size", "type": "text", "default": "PNG or JPG, up to 10 MB each", "max": 60 }
  ],
  "template": "<div class=\"tray-field\"><span class=\"tray-label\" id=\"pg-photos-label\">{{label}}</span><div class=\"tray-drop{{#form=row}} tray-drop--row{{/form=row}}\" data-tray=\"dropzone\" data-list=\"#pg-photos-list\" data-max-mb=\"10\"{{#over}} data-over{{/over}}><span class=\"tray-drop__icon\">{{icon:upload}}</span><p class=\"tray-drop__text\">{{^form=row}}<b>Drop photos here or <u>choose files</u></b>{{/form=row}}{{#form=row}}<b><u>Choose files</u> or drop them here</b>{{/form=row}}{{#detail}}<small>{{detail}}</small>{{/detail}}</p><input type=\"file\" multiple accept=\"image/png, image/jpeg\" aria-labelledby=\"pg-photos-label\"></div><div class=\"tray-attachments\" id=\"pg-photos-list\" style=\"margin-block-start: var(--space-3)\">{{^files=none}}<div class=\"tray-attachment\"><span class=\"tray-attachment__media\">{{icon:image}}</span><span class=\"tray-attachment__body\"><span class=\"tray-attachment__name\">jar-50g-front.jpg</span><span class=\"tray-attachment__meta\">1.4 MB</span></span><button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Remove jar-50g-front.jpg\">{{icon:x}}</button></div>{{/files=none}}{{#files=uploading}}<div class=\"tray-attachment\"><span class=\"tray-attachment__media\">{{icon:image}}</span><span class=\"tray-attachment__body\"><span class=\"tray-attachment__name\">jar-50g-open.jpg</span><span class=\"tray-attachment__meta\">Uploading, 64%</span><span class=\"tray-progress__bar\" role=\"progressbar\" aria-label=\"Uploading jar-50g-open.jpg\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"64\" style=\"--tray-v: 64\"></span></span><button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Cancel the upload of jar-50g-open.jpg\">{{icon:x}}</button></div>{{/files=uploading}}{{#files=large}}<div class=\"tray-attachment\" data-state=\"error\"><span class=\"tray-attachment__media\">{{icon:image}}</span><span class=\"tray-attachment__body\"><span class=\"tray-attachment__name\">farm-at-dawn.png</span><span class=\"tray-attachment__meta\">Too large. The limit is 10 MB.</span></span><button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Remove farm-at-dawn.png\">{{icon:x}}</button></div>{{/files=large}}{{#files=failed}}<div class=\"tray-attachment\" data-state=\"error\"><span class=\"tray-attachment__media\">{{icon:image}}</span><span class=\"tray-attachment__body\"><span class=\"tray-attachment__name\">jar-50g-open.jpg</span><span class=\"tray-attachment__meta\">The connection dropped.</span></span><button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Try jar-50g-open.jpg again\">{{icon:rotate-cw}}</button></div>{{/files=failed}}</div></div>"
}
