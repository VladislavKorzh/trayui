{
  "lead": "A bar for a task, a meter for a level, the busy bar for a wait of unknown length, and the steps of a short process. The yellow fill is for the one bar on an ink card.",
  "width": "34rem",
  "controls": [
    { "name": "kind", "label": "Kind", "options": [["bar", "Bar"], ["meter", "Meter"], ["busy", "Busy"], ["steps", "Steps"]] },
    { "name": "value", "label": "Value", "type": "range", "min": 0, "max": 100, "step": 1, "default": 68, "unit": "%" },
    { "name": "name", "label": "Name", "type": "text", "default": "Packing the autumn batch", "max": 50 },
    { "name": "fill", "label": "Fill", "options": [["", "Ink"], [" tray-progress--accent", "Yellow"]] }
  ],
  "template": "{{#kind=bar}}<div class=\"tray-progress{{fill}}\"><span class=\"tray-progress__name\">{{name}}</span><span class=\"tray-progress__value\">{{value}}%</span><span class=\"tray-progress__bar\" role=\"progressbar\" aria-label=\"{{name}}\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"{{value}}\" style=\"--tray-v: {{value}}\"></span></div>{{/kind=bar}}{{#kind=meter}}<div class=\"tray-progress{{fill}}\"><span class=\"tray-progress__name\">{{name}}</span><span class=\"tray-progress__value\">{{value}}%</span><span class=\"tray-progress__bar\" role=\"meter\" aria-label=\"{{name}}\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"{{value}}\" style=\"--tray-v: {{value}}\"></span></div>{{/kind=meter}}{{#kind=busy}}<div class=\"tray-progress tray-progress--busy{{fill}}\"><span class=\"tray-progress__name\">{{name}}</span><span class=\"tray-progress__value\"></span><span class=\"tray-progress__bar\" role=\"progressbar\" aria-label=\"{{name}}\"></span></div>{{/kind=busy}}{{#kind=steps}}<div class=\"tray-stack tray-stack--sm\"><div class=\"tray-row tray-row--between\"><span class=\"nav\">{{name}}</span><span class=\"tray-soft tray-num\">Step 2 of 4</span></div><div class=\"tray-steps\" role=\"progressbar\" aria-label=\"{{name}}\" aria-valuemin=\"1\" aria-valuemax=\"4\" aria-valuenow=\"2\" aria-valuetext=\"Step 2 of 4\"><span data-done></span><span data-done></span><span></span><span></span></div></div>{{/kind=steps}}"
}
