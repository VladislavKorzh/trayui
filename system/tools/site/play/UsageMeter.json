{
  "lead": "How much of the Shop plan is used: the orders this month (from 90% the meter warns in words), the full block or the compact one for the foot of a sidebar, and the other limits of the plan.",
  "controls": [
    {"name": "used", "label": "Orders used", "options": [["240", "240"], ["842", "842"], ["960", "960"], ["1000", "1,000"]], "default": "842"},
    {"name": "size", "label": "Size", "options": [["full", "Full"], ["sm", "Compact"]]},
    {"name": "more", "label": "Other limits", "type": "switch", "default": true}
  ],
  "template": "{{#size=full}}<div class=\"tray-usage\">{{#used=240}}<div class=\"tray-progress\"><span class=\"tray-progress__name\">Orders this month</span><span class=\"tray-progress__value\">240 of 1,000</span><span class=\"tray-progress__bar\" role=\"meter\" aria-label=\"Orders this month\" aria-valuemin=\"0\" aria-valuemax=\"1000\" aria-valuenow=\"240\" style=\"--tray-v: 24\"></span></div>{{/used=240}}{{#used=842}}<div class=\"tray-progress\"><span class=\"tray-progress__name\">Orders this month</span><span class=\"tray-progress__value\">842 of 1,000</span><span class=\"tray-progress__bar\" role=\"meter\" aria-label=\"Orders this month\" aria-valuemin=\"0\" aria-valuemax=\"1000\" aria-valuenow=\"842\" style=\"--tray-v: 84\"></span></div>{{/used=842}}{{#used=960}}<div class=\"tray-progress\" data-level=\"high\"><span class=\"tray-progress__name\">Orders this month</span><span class=\"tray-progress__value\">960 of 1,000</span><span class=\"tray-progress__bar\" role=\"meter\" aria-label=\"Orders this month\" aria-valuemin=\"0\" aria-valuemax=\"1000\" aria-valuenow=\"960\" style=\"--tray-v: 96\"></span><span class=\"tray-progress__note\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-circle-alert\"/></svg>40 orders left this month. The count starts again on 1 December.</span></div>{{/used=960}}{{#used=1000}}<div class=\"tray-progress\" data-level=\"high\"><span class=\"tray-progress__name\">Orders this month</span><span class=\"tray-progress__value\">1,000 of 1,000</span><span class=\"tray-progress__bar\" role=\"meter\" aria-label=\"Orders this month\" aria-valuemin=\"0\" aria-valuemax=\"1000\" aria-valuenow=\"1000\" style=\"--tray-v: 100\"></span><span class=\"tray-progress__note\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-circle-alert\"/></svg>All 1,000 are used. New orders wait until 1 December, or upgrade the plan to take them now.</span></div>{{/used=1000}}{{#more}}<div class=\"tray-progress\" data-level=\"high\"><span class=\"tray-progress__name\">Team seats</span><span class=\"tray-progress__value\">5 of 5</span><span class=\"tray-progress__bar\" role=\"meter\" aria-label=\"Team seats\" aria-valuemin=\"0\" aria-valuemax=\"5\" aria-valuenow=\"5\" style=\"--tray-v: 100\"></span><span class=\"tray-progress__note\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-circle-alert\"/></svg>Every seat is taken. Add seats to invite more people.</span></div><div class=\"tray-progress\"><span class=\"tray-progress__name\">Label storage</span><span class=\"tray-progress__value\">1.2 of 5 GB</span><span class=\"tray-progress__bar\" role=\"meter\" aria-label=\"Label storage\" aria-valuemin=\"0\" aria-valuemax=\"5\" aria-valuenow=\"1.2\" style=\"--tray-v: 24\"></span></div><div class=\"tray-row tray-row--between\"><span class=\"nav\">API requests</span><span class=\"tray-soft\">Unlimited on this plan</span></div>{{/more}}</div>{{/size=full}}{{#size=sm}}<div class=\"tray-usage tray-usage--sm\">{{#used=240}}<div class=\"tray-progress\"><span class=\"tray-progress__name\">Orders</span><span class=\"tray-progress__value\">240 of 1,000</span><span class=\"tray-progress__bar\" role=\"meter\" aria-label=\"Orders this month\" aria-valuemin=\"0\" aria-valuemax=\"1000\" aria-valuenow=\"240\" style=\"--tray-v: 24\"></span></div>{{/used=240}}{{#used=842}}<div class=\"tray-progress\"><span class=\"tray-progress__name\">Orders</span><span class=\"tray-progress__value\">842 of 1,000</span><span class=\"tray-progress__bar\" role=\"meter\" aria-label=\"Orders this month\" aria-valuemin=\"0\" aria-valuemax=\"1000\" aria-valuenow=\"842\" style=\"--tray-v: 84\"></span></div>{{/used=842}}{{#used=960}}<div class=\"tray-progress\" data-level=\"high\"><span class=\"tray-progress__name\">Orders</span><span class=\"tray-progress__value\">960 of 1,000</span><span class=\"tray-progress__bar\" role=\"meter\" aria-label=\"Orders this month\" aria-valuemin=\"0\" aria-valuemax=\"1000\" aria-valuenow=\"960\" style=\"--tray-v: 96\"></span><span class=\"tray-progress__note\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-circle-alert\"/></svg>40 orders left this month. The count starts again on 1 December.</span></div>{{/used=960}}{{#used=1000}}<div class=\"tray-progress\" data-level=\"high\"><span class=\"tray-progress__name\">Orders</span><span class=\"tray-progress__value\">1,000 of 1,000</span><span class=\"tray-progress__bar\" role=\"meter\" aria-label=\"Orders this month\" aria-valuemin=\"0\" aria-valuemax=\"1000\" aria-valuenow=\"1000\" style=\"--tray-v: 100\"></span><span class=\"tray-progress__note\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-circle-alert\"/></svg>All 1,000 are used. New orders wait until 1 December, or upgrade the plan to take them now.</span></div>{{/used=1000}}<a class=\"tray-btn tray-btn--link\" href=\"/settings/plan\">Upgrade the plan</a></div>{{/size=sm}}"
}
