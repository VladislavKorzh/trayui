{
  "lead": "Several short values in one field, each a chip that can be removed: tags, email addresses, and an address that is wrong. Type in the stage and press Enter.",
  "width": "36rem",
  "controls": [
    { "name": "kind", "label": "Values", "options": [["tags", "Tags"], ["emails", "Emails"], ["invalid", "Invalid"]] },
    { "name": "limit", "label": "Up to four", "type": "switch" },
    { "name": "hint", "label": "Hint", "type": "text", "default": "Press Enter or a comma after each one.", "max": 90 }
  ],
  "template": "<div class=\"tray-field\"><label class=\"tray-label\" for=\"pg-tags\">{{#kind=tags}}Order tags{{/kind=tags}}{{^kind=tags}}Send the report to{{/kind=tags}}</label><div class=\"tray-tags\" data-tray=\"taginput\"{{^kind=tags}} data-pattern=\"email\"{{/kind=tags}}{{#limit}} data-max=\"4\"{{/limit}}{{#kind=invalid}} aria-invalid=\"true\"{{/kind=invalid}}>{{#kind=tags}}<span class=\"tray-chip\" data-value=\"gift\">gift<button type=\"button\" class=\"tray-chip__x\" aria-label=\"Remove gift\">{{icon:x:sm}}</button></span><span class=\"tray-chip\" data-value=\"chilled\">chilled<button type=\"button\" class=\"tray-chip__x\" aria-label=\"Remove chilled\">{{icon:x:sm}}</button></span>{{/kind=tags}}{{^kind=tags}}<span class=\"tray-chip\" data-value=\"oksana@perly.example\">oksana@perly.example<button type=\"button\" class=\"tray-chip__x\" aria-label=\"Remove oksana@perly.example\">{{icon:x:sm}}</button></span>{{/kind=tags}}{{#kind=invalid}}<span class=\"tray-chip\" data-value=\"books@perly\" data-invalid>books@perly<button type=\"button\" class=\"tray-chip__x\" aria-label=\"Remove books@perly\">{{icon:x:sm}}</button></span>{{/kind=invalid}}<input id=\"pg-tags\"{{^kind=tags}} type=\"email\"{{/kind=tags}} placeholder=\"{{#kind=tags}}Add a tag{{/kind=tags}}{{^kind=tags}}Add an email{{/kind=tags}}\"{{#kind=invalid}} aria-describedby=\"pg-tags-error\"{{/kind=invalid}}{{^kind=invalid}}{{#hint}} aria-describedby=\"pg-tags-hint\"{{/hint}}{{^hint}}{{#limit}} aria-describedby=\"pg-tags-hint\"{{/limit}}{{/hint}}{{/kind=invalid}}><input type=\"hidden\" name=\"{{#kind=tags}}tags{{/kind=tags}}{{^kind=tags}}to{{/kind=tags}}\"></div>{{#kind=invalid}}<p class=\"tray-field__error\" id=\"pg-tags-error\">“books@perly” is not a full email address.</p>{{/kind=invalid}}{{^kind=invalid}}{{#hint}}<p class=\"tray-field__hint\" id=\"pg-tags-hint\">{{hint}}{{#limit}} Up to four.{{/limit}}</p>{{/hint}}{{^hint}}{{#limit}}<p class=\"tray-field__hint\" id=\"pg-tags-hint\">Up to four.</p>{{/limit}}{{/hint}}{{/kind=invalid}}</div>"
}
