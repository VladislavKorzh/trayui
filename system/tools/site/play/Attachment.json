{
  "lead": "A file that travels with a message: sent, on its way or failed, a document or a photo, and whether it sits in the thread (download it) or in the composer (remove it).",
  "controls": [
    {"name": "state", "label": "State", "options": [["sent", "Sent"], ["uploading", "Uploading"], ["failed", "Failed"]]},
    {"name": "kind", "label": "Kind", "options": [["file", "File"], ["image", "Image"]]},
    {"name": "where", "label": "Where", "options": [["thread", "Thread"], ["composer", "Composer"]]}
  ],
  "template": "{{#kind=file}}<div class=\"tray-attachments\"><div class=\"tray-attachment\"{{#state=failed}} data-state=\"error\"{{/state=failed}}><span class=\"tray-attachment__media\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-file\"/></svg></span><span class=\"tray-attachment__body\">{{#state=sent}}<a class=\"tray-attachment__link tray-attachment__name\" href=\"/files/receipt-20418.pdf\">receipt-20418.pdf</a>{{/state=sent}}{{^state=sent}}<span class=\"tray-attachment__name\">receipt-20418.pdf</span>{{/state=sent}}<span class=\"tray-attachment__meta\">{{#state=sent}}PDF, 84 KB{{/state=sent}}{{#state=uploading}}Uploading, 42%{{/state=uploading}}{{#state=failed}}The connection dropped at 42%.{{/state=failed}}</span>{{#state=uploading}}<span class=\"tray-progress__bar\" role=\"progressbar\" aria-label=\"Uploading receipt-20418.pdf\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"42\" style=\"--tray-v: 42\"></span>{{/state=uploading}}</span>{{#state=sent}}{{#where=thread}}<button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Download receipt-20418.pdf\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-download\"/></svg></button>{{/where=thread}}{{#where=composer}}<button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Remove receipt-20418.pdf\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-x\"/></svg></button>{{/where=composer}}{{/state=sent}}{{#state=uploading}}<button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Cancel the upload of receipt-20418.pdf\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-x\"/></svg></button>{{/state=uploading}}{{#state=failed}}<button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Try receipt-20418.pdf again\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-rotate-cw\"/></svg></button>{{/state=failed}}</div></div>{{/kind=file}}{{#kind=image}}<div class=\"tray-attachments\"><div class=\"tray-attachment tray-attachment--image\"{{#state=failed}} data-state=\"error\"{{/state=failed}}><span class=\"tray-attachment__media\"><svg class=\"tray-icon tray-icon--lg\" aria-hidden=\"true\"><use href=\"#tray-i-image\"/></svg></span><span class=\"tray-attachment__body\">{{#state=sent}}<a class=\"tray-attachment__link tray-attachment__name\" href=\"/files/gate-photo.jpg\">gate-photo.jpg</a>{{/state=sent}}{{^state=sent}}<span class=\"tray-attachment__name\">gate-photo.jpg</span>{{/state=sent}}<span class=\"tray-attachment__meta\">{{#state=sent}}JPEG, 1.2 MB{{/state=sent}}{{#state=uploading}}Uploading, 42%{{/state=uploading}}{{#state=failed}}The connection dropped at 42%.{{/state=failed}}</span>{{#state=uploading}}<span class=\"tray-progress__bar\" role=\"progressbar\" aria-label=\"Uploading gate-photo.jpg\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"42\" style=\"--tray-v: 42\"></span>{{/state=uploading}}</span>{{#state=sent}}{{#where=thread}}<button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Download gate-photo.jpg\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-download\"/></svg></button>{{/where=thread}}{{#where=composer}}<button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Remove gate-photo.jpg\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-x\"/></svg></button>{{/where=composer}}{{/state=sent}}{{#state=uploading}}<button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Cancel the upload of gate-photo.jpg\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-x\"/></svg></button>{{/state=uploading}}{{#state=failed}}<button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Try gate-photo.jpg again\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-rotate-cw\"/></svg></button>{{/state=failed}}</div></div>{{/kind=image}}"
}
