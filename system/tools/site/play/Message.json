{
  "lead": "One row of a conversation about an order: who speaks (your own messages sit at the end edge and take no avatar), its name and time, what happened to it, and the actions under an assistant’s answer.",
  "controls": [
    {"name": "who", "label": "Who", "options": [["them", "Them"], ["you", "You"], ["assistant", "Assistant"]]},
    {"name": "avatar", "label": "Avatar", "type": "switch", "default": true},
    {"name": "head", "label": "Name and time", "type": "switch", "default": true},
    {"name": "foot", "label": "Under it", "options": [["", "Nothing"], ["delivered", "Delivered"], ["edited", "Edited"]]},
    {"name": "actions", "label": "Answer actions", "type": "switch"},
    {"name": "text", "label": "Text", "type": "text", "default": "The courier has the box. He will call from the gate.", "max": 200}
  ],
  "template": "<div class=\"tray-thread\">{{#who=them}}<div class=\"tray-message\">{{#avatar}}<span class=\"tray-avatar tray-avatar--sm\">OF</span>{{/avatar}}<div class=\"tray-message__content\">{{#head}}<div class=\"tray-message__head\"><b>Oksana</b> 14:02</div>{{/head}}<div class=\"tray-bubble\">{{text}}</div>{{#foot=delivered}}<div class=\"tray-message__foot\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-check\"/></svg>Delivered</div>{{/foot=delivered}}{{#foot=edited}}<div class=\"tray-message__foot\">Edited</div>{{/foot=edited}}</div></div>{{/who=them}}{{#who=you}}<div class=\"tray-message tray-message--end\"><div class=\"tray-message__content\">{{#head}}<div class=\"tray-message__head\"><b>You</b> 14:04</div>{{/head}}<div class=\"tray-bubble tray-bubble--own\">{{text}}</div>{{#foot=delivered}}<div class=\"tray-message__foot\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-check\"/></svg>Delivered</div>{{/foot=delivered}}{{#foot=edited}}<div class=\"tray-message__foot\">Edited</div>{{/foot=edited}}</div></div>{{/who=you}}{{#who=assistant}}<div class=\"tray-message tray-message--top\">{{#avatar}}<span class=\"tray-avatar tray-avatar--sm tray-avatar--accent\" role=\"img\" aria-label=\"Assistant\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-sparkle\"/></svg></span>{{/avatar}}<div class=\"tray-message__content\">{{#head}}<div class=\"tray-message__head\"><b>Assistant</b> 14:03</div>{{/head}}<div class=\"tray-bubble tray-bubble--plain\"><p>{{text}}</p></div>{{#foot=delivered}}<div class=\"tray-message__foot\"><svg class=\"tray-icon tray-icon--sm\" aria-hidden=\"true\"><use href=\"#tray-i-check\"/></svg>Delivered</div>{{/foot=delivered}}{{#foot=edited}}<div class=\"tray-message__foot\">Edited</div>{{/foot=edited}}{{#actions}}<div class=\"tray-message__actions\"><button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Copy the answer\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-copy\"/></svg></button><button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Good answer\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-thumbs-up\"/></svg></button><button class=\"tray-btn tray-btn--ghost tray-btn--xs tray-btn--icon\" type=\"button\" aria-label=\"Try again\"><svg class=\"tray-icon\" aria-hidden=\"true\"><use href=\"#tray-i-rotate-cw\"/></svg></button></div>{{/actions}}</div></div>{{/who=assistant}}</div>"
}
