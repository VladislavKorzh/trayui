{
  "lead": "A strip of tabs: panels it shows and hides in place, or links to pages; which tab is current, across the full width or not, and a count on one tab.",
  "controls": [
    {"name": "use", "label": "Use", "options": [["panels", "Panels"], ["links", "Links"]]},
    {"name": "current", "label": "Current", "options": [["items", "Items"], ["delivery", "Delivery"], ["messages", "Messages"]]},
    {"name": "fill", "label": "Full width", "type": "switch"},
    {"name": "badge", "label": "Count on a tab", "type": "switch", "default": true}
  ],
  "template": "{{#use=panels}}<div data-tray=\"tabs\"><div class=\"tray-tabs{{#fill}} tray-tabs--fill{{/fill}}\" role=\"tablist\" aria-label=\"Order PL-20418\"><button class=\"tray-tab\" role=\"tab\"{{#current=items}} aria-selected=\"true\"{{/current=items}} aria-controls=\"pg-panel-items\" id=\"pg-tab-items\" type=\"button\">Items</button><button class=\"tray-tab\" role=\"tab\"{{#current=delivery}} aria-selected=\"true\"{{/current=delivery}} aria-controls=\"pg-panel-delivery\" id=\"pg-tab-delivery\" type=\"button\">Delivery</button><button class=\"tray-tab\" role=\"tab\"{{#current=messages}} aria-selected=\"true\"{{/current=messages}} aria-controls=\"pg-panel-messages\" id=\"pg-tab-messages\" type=\"button\">Messages{{#badge}} <span class=\"tray-badge tray-badge--count\">3</span>{{/badge}}</button></div><div class=\"tray-tabpanel\" role=\"tabpanel\" id=\"pg-panel-items\" aria-labelledby=\"pg-tab-items\" tabindex=\"0\"{{^current=items}} hidden{{/current=items}}><p class=\"tray-soft\">Two jars of 50 g and a gift box.</p></div><div class=\"tray-tabpanel\" role=\"tabpanel\" id=\"pg-panel-delivery\" aria-labelledby=\"pg-tab-delivery\" tabindex=\"0\"{{^current=delivery}} hidden{{/current=delivery}}><p class=\"tray-soft\">Courier, chilled box, today between 14:00 and 18:00.</p></div><div class=\"tray-tabpanel\" role=\"tabpanel\" id=\"pg-panel-messages\" aria-labelledby=\"pg-tab-messages\" tabindex=\"0\"{{^current=messages}} hidden{{/current=messages}}><p class=\"tray-soft\">Three messages from the courier.</p></div></div>{{/use=panels}}{{#use=links}}<nav class=\"tray-tabs{{#fill}} tray-tabs--fill{{/fill}}\" aria-label=\"Order PL-20418\"><a class=\"tray-tab\" href=\"/orders/PL-20418/items\"{{#current=items}} aria-current=\"page\"{{/current=items}}>Items</a><a class=\"tray-tab\" href=\"/orders/PL-20418/delivery\"{{#current=delivery}} aria-current=\"page\"{{/current=delivery}}>Delivery</a><a class=\"tray-tab\" href=\"/orders/PL-20418/messages\"{{#current=messages}} aria-current=\"page\"{{/current=messages}}>Messages{{#badge}} <span class=\"tray-badge tray-badge--count\">3</span>{{/badge}}</a></nav>{{/use=links}}"
}
