{
  "lead": "One field that also holds an icon, a prefix, a unit or one small button, in either size, and how it shows a wrong value.",
  "controls": [
    { "name": "kind", "label": "Holds", "options": [["search", "Search icon"], ["prefix", "Prefix"], ["unit", "Unit"], ["password", "Show password"], ["code", "Apply button"]] },
    { "name": "size", "label": "Size", "options": [["", "56px"], [" tray-input-group--sm", "48px"]] },
    { "name": "invalid", "label": "Invalid", "type": "switch" }
  ],
  "template": "{{#kind=search}}{{#invalid}}<div class=\"tray-field\">{{/invalid}}<div class=\"tray-input-group{{size}}\"><span class=\"tray-input-group__addon\">{{icon:search}}</span><input class=\"tray-input\" type=\"search\" placeholder=\"Search orders\" aria-label=\"Search orders\"{{#invalid}} value=\"P\" aria-invalid=\"true\" aria-describedby=\"pg-search-error\"{{/invalid}}><span class=\"tray-input-group__addon\"><kbd class=\"tray-kbd\">/</kbd></span></div>{{#invalid}}<p class=\"tray-field__error\" id=\"pg-search-error\">Type two letters or more to search.</p></div>{{/invalid}}{{/kind=search}}{{#kind=prefix}}<div class=\"tray-field\"><label class=\"tray-label\" for=\"pg-shop\">Shop address</label><div class=\"tray-input-group{{size}}\"><span class=\"tray-input-group__addon\">https://</span><input class=\"tray-input\" id=\"pg-shop\" inputmode=\"url\" autocomplete=\"off\"{{#invalid}} value=\"perly.example/snail caviar\" aria-invalid=\"true\" aria-describedby=\"pg-shop-error\"{{/invalid}}{{^invalid}} value=\"perly.example/caviar\"{{/invalid}}></div>{{#invalid}}<p class=\"tray-field__error\" id=\"pg-shop-error\">An address has no spaces. Put a dash between words.</p>{{/invalid}}</div>{{/kind=prefix}}{{#kind=unit}}<div class=\"tray-field\"><label class=\"tray-label\" for=\"pg-weight\">Parcel weight</label><div class=\"tray-input-group{{size}}\"><input class=\"tray-input\" id=\"pg-weight\" inputmode=\"decimal\"{{#invalid}} value=\"7.5\" aria-invalid=\"true\" aria-describedby=\"pg-weight-error\"{{/invalid}}{{^invalid}} value=\"2.5\"{{/invalid}}><span class=\"tray-input-group__addon\">kg</span></div>{{#invalid}}<p class=\"tray-field__error\" id=\"pg-weight-error\">A chilled box takes 5 kg at most. Split the order in two.</p>{{/invalid}}</div>{{/kind=unit}}{{#kind=password}}<div class=\"tray-field\"><label class=\"tray-label\" for=\"pg-password\">New password</label><div class=\"tray-input-group{{size}}\"><span class=\"tray-input-group__addon\">{{icon:lock}}</span><input class=\"tray-input\" id=\"pg-password\" type=\"password\" autocomplete=\"new-password\"{{#invalid}} value=\"snails\" aria-invalid=\"true\" aria-describedby=\"pg-password-error\"{{/invalid}}{{^invalid}} value=\"example-password\"{{/invalid}}><button class=\"tray-input-group__btn\" type=\"button\" data-tray=\"reveal\" aria-label=\"Show password\">{{icon:eye}}</button></div>{{#invalid}}<p class=\"tray-field__error\" id=\"pg-password-error\">Use 10 characters or more.</p>{{/invalid}}</div>{{/kind=password}}{{#kind=code}}<div class=\"tray-field\"><label class=\"tray-label\" for=\"pg-promo\">Promo code</label><div class=\"tray-input-group{{size}}\"><input class=\"tray-input\" id=\"pg-promo\" autocomplete=\"off\" placeholder=\"For example, SPRING\"{{#invalid}} value=\"AUTUMN\" aria-invalid=\"true\" aria-describedby=\"pg-promo-error\"{{/invalid}}><button class=\"tray-input-group__btn tray-input-group__btn--accent\" type=\"button\">Apply</button></div>{{#invalid}}<p class=\"tray-field__error\" id=\"pg-promo-error\">This code ended on 1 November.</p>{{/invalid}}</div>{{/kind=code}}"
}
