{
  "lead": "A chart the bundle draws from the figures in its data-chart: its form, one series or several (ranked bars, the donut and the radial take one, a radar two at most), stacked or stepped where the form allows, the label on the peak, and the table of figures.",
  "width": "36rem",
  "controls": [
    {"name": "form", "label": "Form", "options": [["bar", "Bars"], ["line", "Line"], ["area", "Area"], ["rank", "Ranked bars"], ["donut", "Donut"], ["radial", "Radial"], ["radar", "Radar"]]},
    {"name": "series", "label": "Series", "options": [["1", "One"], ["2", "Two"], ["4", "Four"]]},
    {"name": "stacked", "label": "Stacked", "type": "switch"},
    {"name": "step", "label": "Steps", "type": "switch"},
    {"name": "peak", "label": "Label the peak", "type": "switch", "default": true},
    {"name": "table", "label": "Table of figures", "type": "switch", "default": true}
  ],
  "template": "{{#form=bar}}<figure class=\"tray-chart\" data-tray=\"chart\" data-chart='{\"type\":\"bar\",\"unit\":\" kg\",\"labelHead\":\"Month\",\"labels\":[\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\"],\"series\":{{#series=1}}[{\"name\":\"Collected\",\"values\":[6,14,22,19,9,7,15,10,2]}]{{/series=1}}{{#series=2}}[{\"name\":\"Bed A\",\"values\":[2,5,8,7,3,3,5,4,1]},{\"name\":\"Bed B\",\"values\":[2,4,6,5,3,2,4,3,1]}]{{/series=2}}{{#series=4}}[{\"name\":\"Bed A\",\"values\":[2,5,8,7,3,3,5,4,1]},{\"name\":\"Bed B\",\"values\":[2,4,6,5,3,2,4,3,1]},{\"name\":\"Bed C\",\"values\":[1,3,5,4,2,1,4,2,0]},{\"name\":\"Bed D\",\"values\":[1,2,3,3,1,1,2,1,0]}]{{/series=4}}{{#stacked}}{{^series=1}},\"stacked\":true{{/series=1}}{{/stacked}}{{^peak}}{{#series=1}},\"label\":\"none\"{{/series=1}}{{/peak}}{{^table}},\"table\":false{{/table}},\"summary\":\"{{#stacked}}{{#series=1}}Bar{{/series=1}}{{^series=1}}Stacked bar{{/series=1}}{{/stacked}}{{^stacked}}Bar{{/stacked}} chart of caviar collected each month of the 2026 season, March to November{{#series=1}}. The most, 22 kg, came in May.{{/series=1}}{{#series=2}}, by beds A and B. Bed A gave 38 kg over the season and bed B 30 kg.{{/series=2}}{{#series=4}}, by bed. Bed A gave the most over the season, 38 kg, and bed D the least, 14 kg.{{/series=4}} Demo data.\"}'><figcaption class=\"tray-chart__title\">Caviar collected by month</figcaption></figure>{{/form=bar}}{{#form=line}}<figure class=\"tray-chart\" data-tray=\"chart\" data-chart='{\"type\":\"line\",\"unit\":\" kg\",\"labelHead\":\"Month\",\"labels\":[\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\"],\"series\":{{#series=1}}[{\"name\":\"Collected\",\"values\":[6,14,22,19,9,7,15,10,2]}]{{/series=1}}{{#series=2}}[{\"name\":\"Bed A\",\"values\":[2,5,8,7,3,3,5,4,1]},{\"name\":\"Bed B\",\"values\":[2,4,6,5,3,2,4,3,1]}]{{/series=2}}{{#series=4}}[{\"name\":\"Bed A\",\"values\":[2,5,8,7,3,3,5,4,1]},{\"name\":\"Bed B\",\"values\":[2,4,6,5,3,2,4,3,1]},{\"name\":\"Bed C\",\"values\":[1,3,5,4,2,1,4,2,0]},{\"name\":\"Bed D\",\"values\":[1,2,3,3,1,1,2,1,0]}]{{/series=4}}{{#step}},\"step\":true{{/step}}{{^peak}}{{#series=1}},\"label\":\"none\"{{/series=1}}{{/peak}}{{^table}},\"table\":false{{/table}},\"summary\":\"Line chart of caviar collected each month of the 2026 season, March to November{{#series=1}}. The most, 22 kg, came in May.{{/series=1}}{{#series=2}}, by beds A and B. Bed A gave 38 kg over the season and bed B 30 kg.{{/series=2}}{{#series=4}}, by bed. Bed A gave the most over the season, 38 kg, and bed D the least, 14 kg.{{/series=4}} Demo data.\"}'><figcaption class=\"tray-chart__title\">Caviar collected by month</figcaption></figure>{{/form=line}}{{#form=area}}<figure class=\"tray-chart\" data-tray=\"chart\" data-chart='{\"type\":\"area\",\"unit\":\" kg\",\"labelHead\":\"Month\",\"labels\":[\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\"],\"series\":{{#series=1}}[{\"name\":\"Collected\",\"values\":[6,14,22,19,9,7,15,10,2]}]{{/series=1}}{{#series=2}}[{\"name\":\"Bed A\",\"values\":[2,5,8,7,3,3,5,4,1]},{\"name\":\"Bed B\",\"values\":[2,4,6,5,3,2,4,3,1]}]{{/series=2}}{{#series=4}}[{\"name\":\"Bed A\",\"values\":[2,5,8,7,3,3,5,4,1]},{\"name\":\"Bed B\",\"values\":[2,4,6,5,3,2,4,3,1]},{\"name\":\"Bed C\",\"values\":[1,3,5,4,2,1,4,2,0]},{\"name\":\"Bed D\",\"values\":[1,2,3,3,1,1,2,1,0]}]{{/series=4}}{{#stacked}}{{^series=1}},\"stacked\":true{{/series=1}}{{/stacked}}{{#step}},\"step\":true{{/step}}{{^peak}}{{#series=1}},\"label\":\"none\"{{/series=1}}{{/peak}}{{^table}},\"table\":false{{/table}},\"summary\":\"{{#stacked}}{{#series=1}}Area{{/series=1}}{{^series=1}}Stacked area{{/series=1}}{{/stacked}}{{^stacked}}Area{{/stacked}} chart of caviar collected each month of the 2026 season, March to November{{#series=1}}. The most, 22 kg, came in May.{{/series=1}}{{#series=2}}, by beds A and B. Bed A gave 38 kg over the season and bed B 30 kg.{{/series=2}}{{#series=4}}, by bed. Bed A gave the most over the season, 38 kg, and bed D the least, 14 kg.{{/series=4}} Demo data.\"}'><figcaption class=\"tray-chart__title\">Caviar collected by month</figcaption></figure>{{/form=area}}{{#form=rank}}<figure class=\"tray-chart\" data-tray=\"chart\" data-chart='{\"type\":\"bar\",\"horizontal\":true,\"unit\":\" kg\",\"labelHead\":\"Bed\",\"labels\":[\"Bed A\",\"Bed B\",\"Bed C\",\"Bed D\"],\"series\":[{\"name\":\"Collected\",\"values\":[38,30,22,14]}]{{^table}},\"table\":false{{/table}},\"summary\":\"Ranked bars of caviar collected by bed in the 2026 season: bed A 38 kg, bed B 30 kg, bed C 22 kg, bed D 14 kg. Demo data.\"}'><figcaption class=\"tray-chart__title\">Caviar collected by bed, 2026 season</figcaption></figure>{{/form=rank}}{{#form=donut}}<figure class=\"tray-chart\" data-tray=\"chart\" data-chart='{\"type\":\"donut\",\"unit\":\" kg\",\"totalLabel\":\"Season so far\",\"labelHead\":\"Bed\",\"labels\":[\"Bed A\",\"Bed B\",\"Bed C\",\"Bed D\"],\"series\":[{\"name\":\"Collected\",\"values\":[38,30,22,14]}]{{^table}},\"table\":false{{/table}},\"summary\":\"Donut chart of the 104 kg of caviar collected in the 2026 season, by bed: bed A 38 kg, bed B 30 kg, bed C 22 kg, bed D 14 kg. Demo data.\"}'><figcaption class=\"tray-chart__title\">Where the season&rsquo;s caviar came from</figcaption></figure>{{/form=donut}}{{#form=radial}}<figure class=\"tray-chart\" data-tray=\"chart\" data-chart='{\"type\":\"radial\",\"unit\":\"%\",\"labelHead\":\"Batch\",\"labels\":[\"280 of 412 jars\"],\"series\":[{\"name\":\"Reserved\",\"values\":[68]}]{{^table}},\"table\":false{{/table}},\"summary\":\"Radial chart: 68% of the autumn batch is reserved, 280 of 412 jars. Demo data.\"}'><figcaption class=\"tray-chart__title\">Autumn batch reserved</figcaption></figure>{{/form=radial}}{{#form=radar}}<figure class=\"tray-chart\" data-tray=\"chart\" data-chart='{\"type\":\"radar\",\"max\":10,\"labelHead\":\"Measure\",\"labels\":[\"Moisture\",\"Greens\",\"Activity\",\"Clutches\",\"Shade\"],\"series\":{{#series=1}}[{\"name\":\"Bed A\",\"values\":[8,6,9,7,5]}]{{/series=1}}{{^series=1}}[{\"name\":\"Bed A\",\"values\":[8,6,9,7,5]},{\"name\":\"Bed B\",\"values\":[6,8,6,5,8]}]{{/series=1}}{{^table}},\"table\":false{{/table}},\"summary\":\"Radar chart {{#series=1}}of bed A on five measures scored out of ten. It scores highest on activity, 9, and lowest on shade, 5.{{/series=1}}{{^series=1}}comparing beds A and B on five measures scored out of ten. Bed A leads on activity and moisture, bed B on greens and shade.{{/series=1}} Demo data.\"}'><figcaption class=\"tray-chart__title\">{{#series=1}}Bed A on five measures{{/series=1}}{{^series=1}}Two beds compared{{/series=1}}</figcaption></figure>{{/form=radar}}"
}
