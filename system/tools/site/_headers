# Headers for the site on Cloudflare Workers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN

# The three files and the font may be linked from other sites. Their names stay the same from one release to the
# next, so a browser checks them again after an hour; the font changes less often.
/tokens.css
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/components/bundle.css
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/components/bundle.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800

# The registry (r/, in shadcn's format) and the skill (skills/): read by the trayui and shadcn CLIs, by agents and by
# other sites' tools, so any origin may fetch them. Their names stay the same from one build to the next, so a client
# checks them again after an hour.
/r/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8
/skills/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/skills/marketplace.json
  Content-Type: application/json; charset=utf-8

# The site's own files, and its copies of the three files: each name holds a hash of the content, so a new
# version is a new name, and a browser may keep a copy for a year without asking again.
/_/*
  Cache-Control: public, max-age=31536000, immutable

# Every page as Markdown (components/button.md): UTF-8, as RFC 7763 asks a text/markdown answer to say.
/*.md
  Content-Type: text/markdown; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/articles/feed.xml
  Content-Type: application/atom+xml; charset=utf-8

# The first address of the site still answers; trayui.com is the one to index.
https://trayui.vladislav-korzh95.workers.dev/*
  X-Robots-Tag: noindex

# The shell the shop fills for its pages at /kits (tools/site.py writes it): no page of its own, so no search engine keeps
# it, and the shop asks for it again each minute, so a new build of the site reaches the kits at once.
/shell/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache
