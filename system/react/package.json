{
  "name": "trayui-react",
  "version": "0.4.1",
  "description": "Tray UI for React: typed components over the system's own stylesheet and behaviours, and charts drawn with Recharts.",
  "license": "MIT",
  "author": "Vladyslav Korzh (https://github.com/VladislavKorzh)",
  "homepage": "https://trayui.com/docs/react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladislavKorzh/trayui.git",
    "directory": "system/react"
  },
  "bugs": {
    "url": "https://github.com/VladislavKorzh/trayui/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "css",
    "accessibility",
    "recharts",
    "charts",
    "tray-ui"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/runtime.js",
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.examples.json && node scripts/server.mjs",
    "charts": "node scripts/charts.mjs",
    "try": "node scripts/try.mjs",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-icons": ">=5",
    "recharts": ">=3.9"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    },
    "react-icons": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "highlight.js": "^11.12.0",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-is": "^18.3.1",
    "recharts": "^3.10.1",
    "typescript": "^5.6.3"
  }
}
