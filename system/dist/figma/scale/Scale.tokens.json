{
  "space": {
    "1": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$description": "--space-1. The gap between segments, tabs and stepper buttons; the padding of the tray that holds them."
    },
    "2": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      },
      "$description": "--space-2. Label to field; icon to text in a small control; between stacked choices."
    },
    "3": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      },
      "$description": "--space-3. Control to its text (checkbox, radio, avatar); rows of a compact list."
    },
    "4": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "--space-4. The grid gap between cards; between fields; icon to label in a large button."
    },
    "5": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      },
      "$description": "--space-5. The padding of an accordion row or a list row."
    },
    "6": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "--space-6. Between a heading and its content inside a card."
    },
    "7": {
      "$type": "dimension",
      "$value": {
        "value": 28,
        "unit": "px"
      },
      "$description": "--space-7. Card padding on a phone (the lower end of card-pad)."
    },
    "8": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "px"
      },
      "$description": "--space-8. Horizontal padding of a large button; between groups inside a card."
    },
    "9": {
      "$type": "dimension",
      "$value": {
        "value": 36,
        "unit": "px"
      },
      "$description": "--space-9. Between sections of a form."
    },
    "10": {
      "$type": "dimension",
      "$value": {
        "value": 40,
        "unit": "px"
      },
      "$description": "--space-10. Page padding on desktop (the upper end of page-pad)."
    },
    "12": {
      "$type": "dimension",
      "$value": {
        "value": 48,
        "unit": "px"
      },
      "$description": "--space-12. Card padding on desktop (the upper end of card-pad)."
    },
    "16": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      },
      "$description": "--space-16. Between the parts of an empty state; large vertical breathing room inside a card."
    }
