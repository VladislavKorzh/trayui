{
  // The site of the design system on Cloudflare Workers: the static files of system/site, open to everyone.
  // Deploy with `npx wrangler deploy`: it builds the system and the site first, then uploads them.
  "name": "trayui",
  "compatibility_date": "2026-11-16",

  // The site lives at trayui.com. The old workers.dev address still answers, but _headers tells search engines not
  // to index it, and every page names trayui.com as its canonical address. The addresses of single versions stay off.
  // To put the site behind a password again: add "main": "system/tools/site/worker.js" and, under "assets",
  // "binding": "ASSETS" and "run_worker_first": true, set the secret with `npx wrangler secret put SITE_PASSWORD`,
  // then deploy (system/README.md says more).
  "routes": [{ "pattern": "trayui.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,

  "build": {
    "command": "python3 system/tools/build.py && python3 system/tools/site.py"
  },
  "assets": {
    "directory": "./system/site",
    // Every page is a file: components/lightbox.html is served at /components/lightbox, and /components/lightbox.html
    // or /components/lightbox/ redirect there. index.html is /.
    "html_handling": "auto-trailing-slash",
    // An address with no page is a mistake, and gets 404.html with the status 404.
    "not_found_handling": "404-page"
  }
}
